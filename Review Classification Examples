/**
 * Example 5: Statistical analysis of classification results
 * Demonstrates how to perform statistical analysis on the results
 */
function performStatisticalAnalysis(): void {
  console.log('\n=== Statistical Analysis ===\n');
  
  const results = mockClassificationResults;
  
  // Calculate overall statistics
  const totalReviews = results.length;
  const avgConfidence = results.reduce((sum, result) => sum + result.confidence, 0) / totalReviews;
  const avgProcessingTime = results.reduce((sum, result) => sum + result.processingTime, 0) / totalReviews;
  
  // Sentiment distribution
  const sentimentDistribution = results.reduce((dist, result) => {
    dist[result.sentiment.primary] = (dist[result.sentiment.primary] || 0) + 1;
    return dist;
  }, {} as Record<SentimentType, number>);
  
  // Intent distribution
  const intentDistribution = results.reduce((dist, result) => {
    dist[result.intent.primary] = (dist[result.intent.primary] || 0) + 1;
    return dist;
  }, {} as Record<IntentType, number>);
  
  // Entity type distribution
  const entityTypeDistribution = results.reduce((dist, result) => {
    result.entities.forEach(entity => {
      dist[entity.type] = (dist[entity.type] || 0) + 1;
    });
    return dist;
  }, {} as Record<EntityType, number>);
  
  console.log('Overall Statistics:');
  console.log(`  Total Reviews: ${totalReviews}`);
  console.log(`  Average Confidence: ${(avgConfidence * 100).toFixed(1)}%`);
  console.log(`  Average Processing Time: ${avgProcessingTime.toFixed(0)}ms`);
  
  console.log('\nSentiment Distribution:');
  Object.entries(sentimentDistribution).forEach(([sentiment, count]) => {
    const percentage = ((count / totalReviews) * 100).toFixed(1);
    console.log(`  ${sentiment}: ${count} (${percentage}%)`);
  });
  
  console.log('\nIntent Distribution:');
  Object.entries(intentDistribution).forEach(([intent, count]) => {
    const percentage = ((count / totalReviews) * 100).toFixed(1);
    console.log(`  ${intent}: ${count} (${percentage}%)`);
  });
  
  console.log('\nEntity Type Distribution:');
  const totalEntities = Object.values(entityTypeDistribution).reduce((sum, count) => sum + count, 0);
  Object.entries(entityTypeDistribution).forEach(([entityType, count]) => {
    const percentage = ((count / totalEntities) * 100).toFixed(1);
    console.log(`  ${entityType}: ${count} (${percentage}%)`);
  });
}

/**
 * Example 6: Quality assessment of classification results
 * Demonstrates how to assess the quality and reliability of results
 */
function assessClassificationQuality(): void {
  console.log('\n=== Quality Assessment ===\n');
  
  const results = mockClassificationResults;
  
  // High confidence results
  const highConfidence = results.filter(r => r.confidence >= 0.9);
  const mediumConfidence = results.filter(r => r.confidence >= 0.7 && r.confidence < 0.9);
  const lowConfidence = results.filter(r => r.confidence < 0.7);
  
  console.log('Confidence Distribution:');
  console.log(`  High (≥90%): ${highConfidence.length} reviews`);
  console.log(`  Medium (70-89%): ${mediumConfidence.length} reviews`);
  console.log(`  Low (<70%): ${lowConfidence.length} reviews`);
  
  // Processing time analysis
  const fastProcessing = results.filter(r => r.processingTime < 1000);
  const mediumProcessing = results.filter(r => r.processingTime >= 1000 && r.processingTime < 1500);
  const slowProcessing = results.filter(r => r.processingTime >= 1500);
  
  console.log('\nProcessing Time Distribution:');
  console.log(`  Fast (<1s): ${fastProcessing.length} reviews`);
  console.log(`  Medium (1-1.5s): ${mediumProcessing.length} reviews`);
  console.log(`  Slow (>1.5s): ${slowProcessing.length} reviews`);
  
  // Sentiment confidence analysis
  const sentimentConfidence = results.map(r => ({
    sentiment: r.sentiment.primary,
    confidence: r.sentiment.confidence
  }));
  
  const avgSentimentConfidence = sentimentConfidence.reduce((sum, item) => sum + item.confidence, 0) / sentimentConfidence.length;
  console.log(`\nAverage Sentiment Confidence: ${(avgSentimentConfidence * 100).toFixed(1)}%`);
  
  // Topic detection analysis
  const totalTopics = results.reduce((sum, r) => sum + r.topics.length, 0);
  const avgTopicsPerReview = totalTopics / results.length;
  console.log(`Average Topics per Review: ${avgTopicsPerReview.toFixed(1)}`);
  
  // Entity detection analysis
  const totalEntities = results.reduce((sum, r) => sum + r.entities.length, 0);
  const avgEntitiesPerReview = totalEntities / results.length;
  console.log(`Average Entities per Review: ${avgEntitiesPerReview.toFixed(1)}`);
}

