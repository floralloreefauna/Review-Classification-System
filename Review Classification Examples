/**
 * Example 2: Working with classification results
 * Shows how to analyze and extract information from AI classification results
 */
function analyzeClassificationResults(): void {
  console.log('=== Review Classification Analysis ===\n');
  
  // Get all positive reviews
  const positiveReviews = getClassificationResultsBySentiment('positive');
  console.log(`Found ${positiveReviews.length} positive reviews`);
  
  // Get all negative reviews
  const negativeReviews = getClassificationResultsBySentiment('negative');
  console.log(`Found ${negativeReviews.length} negative reviews`);
  
  // Get high confidence results
  const highConfidenceResults = getHighConfidenceResults(0.9);
  console.log(`Found ${highConfidenceResults.length} high confidence results (>= 90%)\n`);
  
  // Analyze a specific review
  const specificResult = getClassificationResultByReviewId('review_001');
  if (specificResult) {
    console.log('=== Specific Review Analysis ===');
    console.log(`Review ID: ${specificResult.reviewInput.id}`);
    console.log(`Platform: ${specificResult.reviewInput.platform}`);
    console.log(`Rating: ${specificResult.reviewInput.rating}/5`);
    console.log(`Sentiment: ${specificResult.sentiment.primary} (${(specificResult.sentiment.score * 100).toFixed(1)}%)`);
    console.log(`Confidence: ${(specificResult.confidence * 100).toFixed(1)}%`);
    console.log(`Intent: ${specificResult.intent.primary}`);
    console.log(`Processing Time: ${specificResult.processingTime}ms`);
    
    console.log('\n=== Detected Topics ===');
    specificResult.topics.forEach((topic, index) => {
      console.log(`${index + 1}. ${topic.name} (${(topic.confidence * 100).toFixed(1)}% confidence)`);
      console.log(`   Keywords: ${topic.keywords.join(', ')}`);
      console.log(`   Sentiment: ${topic.topicSentiment}`);
    });
    
    console.log('\n=== Detected Entities ===');
    specificResult.entities.forEach((entity, index) => {
      console.log(`${index + 1}. ${entity.name} (${entity.type})`);
      console.log(`   Confidence: ${(entity.confidence * 100).toFixed(1)}%`);
      console.log(`   Sentiment: ${entity.entitySentiment}`);
      if (entity.attributes?.quality) {
        console.log(`   Quality: ${entity.attributes.quality}/5`);
      }
    });
    
    console.log('\n=== Emotions Detected ===');
    specificResult.emotions.forEach((emotion, index) => {
      console.log(`${index + 1}. ${emotion.emotion} (${(emotion.confidence * 100).toFixed(1)}% confidence, ${(emotion.intensity * 100).toFixed(1)}% intensity)`);
    });
  }
}

/**
 * Example 3: Platform-specific analysis
 * Demonstrates how to analyze reviews by platform
 */
function analyzeByPlatform(): void {
  console.log('\n=== Platform Analysis ===\n');
  
  const platforms: ReviewPlatform[] = ['amazon', 'trustpilot', 'yelp', 'app_store', 'google'];
  
  platforms.forEach(platform => {
    const platformResults = getClassificationResultsByPlatform(platform);
    if (platformResults.length > 0) {
      console.log(`${platform.toUpperCase()}:`);
      console.log(`  Total reviews: ${platformResults.length}`);
      
      const avgConfidence = platformResults.reduce((sum, result) => sum + result.confidence, 0) / platformResults.length;
      console.log(`  Average confidence: ${(avgConfidence * 100).toFixed(1)}%`);
      
      const avgProcessingTime = platformResults.reduce((sum, result) => sum + result.processingTime, 0) / platformResults.length;
      console.log(`  Average processing time: ${avgProcessingTime.toFixed(0)}ms`);
      
      const sentimentCounts = platformResults.reduce((counts, result) => {
        counts[result.sentiment.primary] = (counts[result.sentiment.primary] || 0) + 1;
        return counts;
      }, {} as Record<SentimentType, number>);
      
      console.log(`  Sentiment distribution:`, sentimentCounts);
      console.log('');
    }
  });
}

