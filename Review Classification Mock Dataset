/**
 * Generate a random review classification result
 * Useful for testing and development
 */
export function generateRandomClassificationResult(
  reviewInput: ReviewInput
): ReviewClassificationResult {
  const sentimentTypes: SentimentType[] = ['positive', 'negative', 'neutral', 'mixed'];
  const intentTypes: IntentType[] = ['complaint', 'praise', 'question', 'recommendation', 'warning', 'comparison', 'request', 'feedback', 'review'];
  const emotionTypes: EmotionType[] = ['joy', 'sadness', 'anger', 'fear', 'surprise', 'disgust', 'trust', 'anticipation', 'frustration', 'satisfaction', 'disappointment', 'excitement'];
  
  const randomSentiment = sentimentTypes[Math.floor(Math.random() * sentimentTypes.length)];
  const randomIntent = intentTypes[Math.floor(Math.random() * intentTypes.length)];
  const randomEmotion = emotionTypes[Math.floor(Math.random() * emotionTypes.length)];
  
  return {
    id: `classification_${Date.now()}`,
    reviewInput,
    sentiment: {
      primary: randomSentiment,
      score: randomSentiment === 'positive' ? Math.random() * 0.5 + 0.5 : 
             randomSentiment === 'negative' ? Math.random() * -0.5 - 0.5 : 
             Math.random() * 0.2 - 0.1,
      confidence: Math.random() * 0.2 + 0.8,
      intensity: Math.random() > 0.5 ? 'strong' : 'moderate',
      polarity: {
        positive: randomSentiment === 'positive' ? 0.8 : 0.1,
        negative: randomSentiment === 'negative' ? 0.8 : 0.1,
        neutral: randomSentiment === 'neutral' ? 0.8 : 0.1,
        mixed: randomSentiment === 'mixed' ? 0.8 : 0.1
      }
    },
    topics: [
      {
        name: 'general_topic',
        confidence: Math.random() * 0.2 + 0.8,
        relevance: Math.random() * 0.3 + 0.7,
        topicSentiment: randomSentiment,
        keywords: ['keyword1', 'keyword2'],
        hierarchy: ['category', 'subcategory']
      }
    ],
    entities: [
      {
        name: 'sample_entity',
        type: 'product',
        confidence: Math.random() * 0.2 + 0.8,
        entitySentiment: randomSentiment,
        position: { start: 0, end: 10 }
      }
    ],
    intent: {
      primary: randomIntent,
      confidence: Math.random() * 0.2 + 0.8,
      intensity: Math.random() > 0.5 ? 'strong' : 'moderate'
    },
    emotions: [
      {
        emotion: randomEmotion,
        confidence: Math.random() * 0.2 + 0.8,
        intensity: Math.random() * 0.5 + 0.5
      }
    ],
    confidence: Math.random() * 0.2 + 0.8,
    processingTime: Math.floor(Math.random() * 1000) + 500,
    timestamp: new Date()
  };
}

/**
 * Get a specific classification result by review ID
 */
export function getClassificationResultByReviewId(reviewId: string): ReviewClassificationResult | undefined {
  return mockClassificationResults.find(result => result.reviewInput.id === reviewId);
}

/**
 * Get all classification results for a specific sentiment type
 */
export function getClassificationResultsBySentiment(sentiment: SentimentType): ReviewClassificationResult[] {
  return mockClassificationResults.filter(result => result.sentiment.primary === sentiment);
}

/**
 * Get all classification results for a specific platform
 */
export function getClassificationResultsByPlatform(platform: ReviewPlatform): ReviewClassificationResult[] {
  return mockClassificationResults.filter(result => result.reviewInput.platform === platform);
}

/**
 * Get classification results with high confidence (above threshold)
 */
export function getHighConfidenceResults(threshold: number = 0.9): ReviewClassificationResult[] {
  return mockClassificationResults.filter(result => result.confidence >= threshold);
}

